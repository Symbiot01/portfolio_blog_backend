# The database URL for your locally running MongoDB
DATABASE_URL="mongodb://localhost:27017"
DATABASE_NAME="portfolio_db"

# A secret key for encoding JWT tokens. CHANGE THIS to a long, random string.
SECRET_KEY="a-very-secret-key-that-you-should-definitely-change"

CLOUDINARY_URL=cloudinary://few-random-numbers:-some-secret-string

# Optional: Gemini fallback when HTTP product URL scrape is blocked (e.g. Amazon).
# Keep server-side only. AI never auto-fills price; images come from search candidates.
# GEMINI_API_KEY=
# WISHLIST_PREVIEW_AI_FALLBACK=true
# WISHLIST_PREVIEW_GEMINI_MODEL=gemini-2.0-flash
# WISHLIST_PREVIEW_GEMINI_TIMEOUT_S=20

# Optional image search for AI fallback (pick up to 10 real photos in the UI).
# Google Programmable Search (image mode) — needs a CSE id + API key:
# GOOGLE_CSE_API_KEY=   # or reuse GEMINI_API_KEY if Custom Search API is enabled on that key
# GOOGLE_CSE_CX=
# Or Serper Google Images:
# SERPER_API_KEY=
